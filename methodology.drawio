        <mxCell id="27" style="endArrow=block;html=1;strokeColor=#1D4ED8;" edge="1" parent="1" source="5" target="10"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Merge all branches to comparison -->
        <mxCell id="28" style="endArrow=block;html=1;strokeColor=#374151;" edge="1" parent="1" source="6" target="11"><mxGeometry relative="1" as="geometry"/></mxCell>
