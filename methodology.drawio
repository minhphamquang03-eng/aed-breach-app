        <mxCell id="23" style="endArrow=block;html=1;strokeColor=#1D4ED8;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="24" style="endArrow=block;html=1;strokeColor=#1D4ED8;" edge="1" parent="1" source="5" target="7"><mxGeometry relative="1" as="geometry"/></mxCell>
